<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:id="@+id/quickspace_content"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="start|center_vertical"
    android:orientation="vertical">

    <!-- Day of the Week -->
    <com.android.launcher3.quickspace.views.DoubleShadowTextView
        android:id="@+id/quickspace_day_of_week"
        android:fontFamily="@font/SlateForOnePlus-Medium"
        android:paddingStart="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?workspaceTextColor"
        android:textSize="28sp"
        launcher:ambientShadowBlur="3dp"
        launcher:ambientShadowColor="?workspaceAmbientShadowColor"
        launcher:keyShadowBlur="2dp"
        launcher:keyShadowColor="?workspaceKeyShadowColor"
        launcher:keyShadowOffsetX="0.5dip" />

    <!-- Clock -->
    <LinearLayout
        android:paddingStart="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextClock
            android:id="@+id/quickspace_clock_hour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/SlateForOnePlus-Bold"
            android:textColor="#FE4543"
            android:textSize="80sp"
            android:format12Hour="h"
            android:format24Hour="H"
            android:includeFontPadding="false" />

        <TextClock
            android:id="@+id/quickspace_clock_minute"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/SlateForOnePlus-Bold"
            android:textColor="?workspaceTextColor"
            android:textSize="80sp"
            android:format12Hour=":mm"
            android:format24Hour=":mm"
            android:includeFontPadding="false" />

    </LinearLayout>

    <!-- Date and Weather Row -->
    <LinearLayout
        android:id="@+id/date_weather_row"
        android:paddingStart="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.android.launcher3.quickspace.views.DoubleShadowTextView
            android:id="@+id/quickspace_date"
            android:fontFamily="@font/SlateForOnePlus-Regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?workspaceTextColor"
            android:textSize="@dimen/quickspace_subtitle_size"
            android:paddingEnd="10dp"
            launcher:ambientShadowBlur="3dp"
            launcher:ambientShadowColor="?workspaceAmbientShadowColor"
            launcher:keyShadowBlur="2dp"
            launcher:keyShadowColor="?workspaceKeyShadowColor"
            launcher:keyShadowOffsetX="0.5dip" />

        <include layout="@layout/quickspace_weather_content" />

    </LinearLayout>

    <!-- Contextual Info (PSA or Now Playing) -->
    <FrameLayout
        android:id="@+id/contextual_info_row"
        android:paddingStart="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">
        
        <!-- Now Playing -->
        <LinearLayout
            android:id="@+id/now_playing_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">
            <ImageView
                android:id="@+id/now_playing_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_music_note_24dp"
                android:tint="?workspaceTextColor"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:id="@+id/now_playing_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?workspaceTextColor"
                android:textSize="@dimen/quickspace_subtitle_size"
                android:singleLine="true"/>
        </LinearLayout>

        <!-- PSA Message -->
        <com.android.launcher3.quickspace.views.DoubleShadowTextView
            android:id="@+id/quickspace_psa_message"
            android:fontFamily="@font/SlateForOnePlus-Regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?workspaceTextColor"
            android:textSize="@dimen/quickspace_subtitle_size"
            android:visibility="gone"
            launcher:ambientShadowBlur="3dp"
            launcher:ambientShadowColor="?workspaceAmbientShadowColor"
            launcher:keyShadowBlur="2dp"
            launcher:keyShadowColor="?workspaceKeyShadowColor"
            launcher:keyShadowOffsetX="0.5dip" />

    </FrameLayout>

</LinearLayout>
